{
  "name": "@lehelkovach/knowshowgo-client",
  "version": "0.2.22-dev",
  "description": "JavaScript client SDK for the KnowShowGo semantic memory engine (Python SDK ships separately from python/)",
  "type": "module",
  "main": "js/index.js",
  "exports": {
    ".": {
      "import": "./js/index.js"
    },
    "./client": {
      "import": "./js/client.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lehelkovach/knowshowgo-client.git"
  },
  "homepage": "https://github.com/lehelkovach/knowshowgo-client",
  "bugs": {
    "url": "https://github.com/lehelkovach/knowshowgo-client/issues"
  },
  "keywords": [
    "semantic-memory",
    "knowledge-graph",
    "ai-agents",
    "hallucination-detection",
    "knowshowgo"
  ],
  "author": "Leh Kovach",
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.0.0",
    "esbuild": "^0.17.0"
  },
  "scripts": {
    "test": "node --test js/*.test.mjs",
    "test:python": "python3 -m unittest discover -s python/tests -p 'test_*.py'",
    "test:all": "npm test && npm run test:python",
    "test:integration": "node --test scripts/live-contract-smoke.js",
    "test:integration:live": "node scripts/live-contract-smoke.js",
    "build": "esbuild js/index.js --bundle --platform=node --format=esm --outfile=dist/index.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "files": [
    "js",
    "!js/*.test.mjs",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
